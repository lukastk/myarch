---------------
---- INPUT ----
---------------

hl.config({
    input = {
        -- pocket4's built-in keyboard is physically US-ANSI, not UK-ISO, so a
        -- gb layout mistypes @ " # ~ | and the £/# key. Every other machine
        -- keeps gb. Second layout stays Swedish on both (grp:caps_toggle).
        kb_layout  = "{% if 'pocket4' in targets %}us,se{% else %}gb,se{% endif %}",
        kb_variant = "",
        kb_model   = "",
        -- Caps Lock is remapped to F12 at the evdev layer by keyd (see
        -- myarch install.py keyd integration), so XKB never receives a capslock
        -- keycode and the old "grp:caps_toggle" layout switch could never fire.
        -- Switch layouts by clicking the waybar language module instead.
        kb_options = "",
        kb_rules   = "",

        -- Key repeat. Hyprland's defaults are much slower (rate 25, delay 600).
        --
        -- The macOS counterpart is myrig's setup/installs/mac/misc.py. Its
        -- `defaults` values count in 1/60 s steps, not 15 ms: `ioreg` on both
        -- Macs reports HIDInitialKeyRepeat=166666666 and HIDKeyRepeat=16666666
        -- (nanoseconds), so
        --   macOS InitialKeyRepeat 10 = 167 ms delay
        --   macOS KeyRepeat 1         = 60/sec
        -- There is no equivalent of ApplePressAndHoldEnabled: holding a key
        -- already repeats on Linux, which is what that macOS setting restores.
        --
        -- pocket4 takes the Mac's rate but a LONGER delay than the Mac. At
        -- 150 ms, ordinary typing doubled letters ("helloo") that never double
        -- on the Macs. The likely reason is where repetition happens: macOS
        -- repeats in its HID event system from the real key state, while on
        -- Wayland every client runs its own timer from wl_keyboard.repeat_info.
        -- A key release that reaches the app late (compositor, keyd or the app
        -- itself busy) therefore becomes a spurious repeat, and a longer delay
        -- is the only margin available.
        --
        -- Future Wayland: since wl_keyboard version 10 a compositor may take
        -- over repetition (repeat_info with rate 0, then key events in the
        -- "repeated" state), which is the macOS model. Hyprland 0.56.2 only
        -- advertises wl_seat version 9 (`wayland-info | grep wl_seat`,
        -- 2026-09-17). Once Hyprland advertises 10+ and does compositor-side
        -- repeat, and the apps in use bind it, retry pocket4 at the Mac's
        -- 167 ms.
        --
        -- ideapad keeps a slower 50/sec (the Mac-like rate overshoots on its
        -- keyboard) and the 150 ms delay it had before.
        repeat_rate  = {% if 'ideapad' in targets %}50{% else %}60{% endif %},
        repeat_delay = {% if 'ideapad' in targets %}150{% else %}200{% endif %},

        follow_mouse = 1,

        sensitivity = 0,

        touchpad = {
            natural_scroll = true,
        },
    },
})
