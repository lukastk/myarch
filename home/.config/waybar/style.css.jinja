/* myarch's Omarchy-inspired Waybar: one quiet surface, state through colour.
 * Pocket 4 keeps touch-size hit boxes; minimalism comes from hierarchy rather
 * than shrinking the controls below a comfortable physical size. */

@define-color background {{ theme.background }};
@define-color surface {{ theme.surface }};
@define-color surface_hover {{ theme.surface_hover }};
@define-color foreground {{ theme.foreground }};
@define-color muted {{ theme.muted }};
@define-color accent {{ theme.accent }};
@define-color accent_alt {{ theme.accent_alt }};
@define-color urgent {{ theme.urgent }};
@define-color warning {{ theme.warning }};
@define-color success {{ theme.success }};

* {
  border: none;
  border-radius: 0;
  font-family: "IoskeleyMonoTerm Nerd Font Mono";
{% if 'pocket4' in targets %}
  font-size: 17px;
  min-height: 18px;
{% else %}
  font-size: 13px;
  min-height: 14px;
{% endif %}
}

window#waybar {
  background: alpha(@background, 0.96);
  color: @foreground;
}
window#waybar.hidden { opacity: 0.25; }

/* Every top-level item uses the same surface. Persistent coloured islands are
 * deliberately absent; hover and active state are the only backgrounds. */
#custom-archicon,
#clock,
#cpu,
#memory,
#disk,
#temperature,
#battery,
#idle_inhibitor,
#pulseaudio,
#pulseaudio-slider,
#backlight,
#backlight-slider,
#network,
#language,
#custom-apps-handle,
#custom-tray-handle,
#custom-display-handle,
#custom-scaleup,
#custom-scaledown,
#custom-gaps,
#custom-rotate,
#custom-flip,
#custom-tabletmode,
#custom-osk,
#custom-thermal,
#custom-recording {
  color: @foreground;
  background: transparent;
{% if 'pocket4' in targets %}
  min-height: 42px;
  padding: 0 10px;
{% else %}
  min-height: 26px;
  padding: 0 7px;
{% endif %}
  transition: background 120ms ease, color 120ms ease;
}

#custom-archicon:hover,
#clock:hover,
#battery:hover,
#idle_inhibitor:hover,
#pulseaudio:hover,
#backlight:hover,
#network:hover,
#language:hover,
#custom-apps-handle:hover,
#custom-tray-handle:hover,
#custom-display-handle:hover,
#custom-rotate:hover,
#custom-tabletmode:hover,
#custom-osk:hover,
#custom-thermal:hover {
  background: @surface_hover;
}

#custom-archicon { color: @accent; font-size: 18px; }
#clock { color: @foreground; font-weight: 600; }
#cpu, #memory, #disk, #temperature { color: @muted; }
#battery.warning { color: @warning; }
#battery.critical { color: @urgent; }
#battery.charging { color: @success; }
#network.disconnected { color: @urgent; }
#idle_inhibitor.deactivated { color: @muted; }
#idle_inhibitor.activated { color: @accent; background: @surface; }
#language { color: @muted; }
#custom-tray-handle { color: @muted; }

/* Drawers stay visibly related without becoming separate pastel pills. */
#sysinfo,
#apps,
#display,
#brightness,
#volume { background: transparent; }

#backlight-slider,
#pulseaudio-slider {
  min-width: 220px;
  padding: 0 10px;
}
#backlight-slider trough,
#pulseaudio-slider trough {
  min-height: 5px;
  border-radius: 3px;
  background: @surface;
}
#backlight-slider highlight,
#pulseaudio-slider highlight {
  border-radius: 3px;
  background: @accent;
}
#backlight-slider slider,
#pulseaudio-slider slider {
  min-width: 16px;
  min-height: 16px;
  border-radius: 8px;
  background: @foreground;
}

/* Hardware cluster: large targets, restrained colour. State is a foreground
 * change or a subtle shared surface, never a permanent rainbow block. */
#custom-rotate,
#custom-tabletmode,
#custom-osk,
#custom-thermal,
#custom-display-handle,
#custom-flip,
#custom-scaleup,
#custom-scaledown,
#custom-gaps {
{% if 'pocket4' in targets %}
  min-width: 28px;
  padding: 0 12px;
  font-size: 21px;
{% endif %}
}
#custom-rotate.portrait,
#custom-tabletmode.on,
#custom-osk.on { color: @accent; background: @surface; }
#custom-thermal.quiet { color: {{ theme.quiet }}; }
#custom-thermal.chill { color: {{ theme.chill }}; }
#custom-thermal.balanced { color: @foreground; }
#custom-thermal.performance { color: {{ theme.performance }}; background: @surface; }

/* Workspaces remain role-coloured in their labels, but share one flat strip. */
#workspaces,
#taskbar,
#tray { background: transparent; }
#workspaces button,
#taskbar button {
  color: @muted;
  background: transparent;
  padding: 0 6px;
  margin: 0;
  border-bottom: 2px solid transparent;
  transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
}
#workspaces button.occupied { color: @foreground; }
#workspaces button.active { color: @accent; border-bottom-color: @accent; }
#workspaces button.urgent { color: @urgent; border-bottom-color: @urgent; }
#workspaces button:hover,
#taskbar button:hover { background: @surface_hover; }
#taskbar button.active { border-bottom-color: @accent; }
#tray { padding: 0 7px; }
#tray menu { background: @background; color: @foreground; }
#tray menu menuitem:hover { background: @surface_hover; }

/* Pocket custom workspaces exist because Waybar's built-in click dispatch is
 * incompatible with Hyprland's Lua parser. They mirror the same flat states. */
#custom-ws1,
#custom-ws2,
#custom-ws3,
#custom-ws4,
#custom-ws5,
#custom-ws6,
#custom-ws7,
#custom-ws8,
#custom-ws9,
#custom-ws10,
#custom-wsspecial {
  color: @muted;
  background: transparent;
  min-height: 42px;
  padding: 0 8px;
  font-size: 18px;
  border-bottom: 2px solid transparent;
}
#custom-ws1.occupied,
#custom-ws2.occupied,
#custom-ws3.occupied,
#custom-ws4.occupied,
#custom-ws5.occupied,
#custom-ws6.occupied,
#custom-ws7.occupied,
#custom-ws8.occupied,
#custom-ws9.occupied,
#custom-ws10.occupied { color: @foreground; }
#custom-ws1.active,
#custom-ws2.active,
#custom-ws3.active,
#custom-ws4.active,
#custom-ws5.active,
#custom-ws6.active,
#custom-ws7.active,
#custom-ws8.active,
#custom-ws9.active,
#custom-ws10.active,
#custom-wsspecial.active { color: @accent; border-bottom-color: @accent; background: @surface; }
#custom-wsspecial { color: @accent_alt; }

/* Dictation remains unmistakable: these colours encode microphone/processing
 * state and are safety information, not decoration. */
#custom-voxtype {
  color: @background;
  font-weight: bold;
  min-height: 38px;
  padding: 0 10px;
}
#custom-voxtype.idle { min-height: 0; padding: 0; background: transparent; }
#custom-voxtype.recording { background: {{ theme.recording }}; color: #ffffff; padding: 0 15px; }
#custom-voxtype.transcribing { background: {{ theme.transcribing }}; }

#custom-voxtype-start,
#custom-voxtype-cleanup,
#custom-voxtype-cancel {
  min-width: 76px;
  min-height: 38px;
  padding: 0 10px;
  margin: 2px;
  border-radius: 4px;
  color: @foreground;
  background: @surface;
  font-size: 15px;
}
#custom-voxtype-start { color: @background; background: @accent; }
#custom-voxtype-cleanup.on { color: @background; background: {{ theme.cleaning }}; }
#custom-voxtype-cleanup.off { color: {{ theme.cleaning }}; }
#custom-voxtype-cancel { color: @urgent; box-shadow: inset 0 0 0 1px @urgent; background: transparent; }
#custom-voxtype-cancel:hover { color: #ffffff; background: @urgent; }
#custom-voxtype-start.hidden,
#custom-voxtype-cleanup.hidden,
#custom-voxtype-cancel.hidden,
window#waybar.narrow-bottom #custom-voxtype-start.hidden,
window#waybar.narrow-bottom #custom-voxtype-cleanup.hidden,
window#waybar.narrow-bottom #custom-voxtype-cancel.hidden {
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  background: transparent;
  box-shadow: none;
}
window#waybar.narrow-bottom #custom-voxtype-start,
window#waybar.narrow-bottom #custom-voxtype-cleanup,
window#waybar.narrow-bottom #custom-voxtype-cancel { min-width: 54px; }

#custom-recording.active { color: #ffffff; background: @urgent; font-weight: bold; }
#custom-recording.inactive { min-width: 0; min-height: 0; padding: 0; }

tooltip { background: @background; color: @foreground; border: 1px solid @surface_hover; }
