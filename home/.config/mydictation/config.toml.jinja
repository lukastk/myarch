# mydictation — https://github.com/lukastk/mydictation
# Rendered by Myarch from home/.config/mydictation/config.toml.jinja
#
# DO NOT HAND-EDIT: install-home.py replaces this file on every deploy. Machine
# defaults belong here (in the template); YOUR settings belong in
# config.local.toml next to it, which layers on top of this and wins. That is
# what `mydictation settings` (Super+Ctrl+D) writes, and why it survives a
# Myarch installation.
#
# Unknown keys are a hard error, so a typo here fails loudly rather than
# silently leaving the default in place. `mydictation doctor` explains the
# capture settings; `mydictation doctor --seconds 3` measures the microphone.

backend = "openai"    # openai | deepgram | elevenlabs | parakeet (local)
inject  = "type"      # clipboard | type | paste
cleanup = false       # Super+Shift+D dictates with the LLM rewrite;
                      # Super+Alt+D promotes one already in progress.
notify  = true

[capture]
{% if 'pocket4' in targets %}
# pocket4's internal mic reports Base Volume 10% / -60 dB, so the top 90% of the
# slider is hardware boost: at the default 100% the signal is pinned at full
# scale and every transcript is garbage, with no error anywhere in the audio
# stack. mydictation lowers it for the duration of a recording and restores it
# afterwards. Machine-specific — check with `mydictation doctor --seconds 3`
# before copying this to another machine.
source_volume = "25%"
{% endif %}
# A latched recording has nothing waiting to stop it, so cap it. Enforced by
# pw-record itself (--sample-count), and it counts captured AUDIO, not wall
# clock. The audio is kept, not discarded.
max_seconds = 300

[inject_options]
# 0 omits wtype's -d flag, which is both its default and its fastest setting.
# Measured over 30 trials of 139 characters: omitted = 235 chars/sec, 30/30
# exact, 0 runs lost a character; -d 1 = 189 chars/sec, also 30/30. So the
# default is both the fastest AND lossless — raise it only for an app that
# cannot keep up with input events, not to avoid dropped characters.
type_delay_ms = 0
paste_chord   = "ctrl+v"    # terminals want "ctrl+shift+v"

[backends.openai]
model    = "gpt-4o-transcribe"
language = "en"

[backends.deepgram]
model = "nova-3"

# Local, on-device transcription. No network, no API key, no per-minute cost.
# Needs the model downloaded (`mydictation model download parakeet-v3`, or pick
# it in the settings UI, which offers to fetch it). Measured on pocket4, CPU
# only: 25x realtime, ~0.27s for a 6.5s dictation once the daemon has it warm.
# parakeet-v3 = 25 European languages; parakeet-v2 = English only, slightly
# better English WER. Switch to it with `backend = "parakeet"` in
# config.local.toml, not here.
[backends.parakeet]
model       = "parakeet-v3"
num_threads = 8

[cleanup_llm]
model  = "claude-opus-5"
effort = "low"
