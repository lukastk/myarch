# mako — notification daemon (≙ macOS notifications / Hammerspoon toasts on
# the macbook; sesh-notify and ~/.mybin/notify land here via notify-send).
# Arthur-ish colors matching kitty/hyprlock.

font=JetBrainsMono Nerd Font 11
background-color={{ theme.background }}
text-color={{ theme.foreground }}
border-color={{ theme.accent }}
border-size=2
border-radius=8
padding=10
margin=10
default-timeout=8000
max-visible=5
anchor=top-right
