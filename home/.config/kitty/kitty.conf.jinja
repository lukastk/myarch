# myarch kitty config (desktop) — the Linux terminal, mirroring the
# macbook WezTerm setup: JetBrains Mono + the "Arthur" color scheme
# (home/^macbook^/.wezterm.lua). kitty speaks the kitty keyboard protocol
# natively, so Shift+Enter etc. pass through tmux to Claude Code / pi
# (≙ wezterm's enable_kitty_keyboard).

font_family      JetBrainsMono Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        11.0

enable_audio_bell no
confirm_os_window_close 0
scrollback_lines 10000

# --- Arthur color scheme ---
foreground {{ theme.foreground }}
background {{ theme.background }}

cursor {{ theme.cursor }}
cursor_text_color {{ theme.cursor_text }}

selection_background {{ theme.selection_background }}
selection_foreground {{ theme.selection_foreground }}

# black
color0 {{ theme.palette[0] }}
color8 {{ theme.palette[8] }}

# red
color1 {{ theme.palette[1] }}
color9 {{ theme.palette[9] }}

# green
color2 {{ theme.palette[2] }}
color10 {{ theme.palette[10] }}

# yellow
color3 {{ theme.palette[3] }}
color11 {{ theme.palette[11] }}

# blue
color4 {{ theme.palette[4] }}
color12 {{ theme.palette[12] }}

# magenta
color5 {{ theme.palette[5] }}
color13 {{ theme.palette[13] }}

# cyan
color6 {{ theme.palette[6] }}
color14 {{ theme.palette[14] }}

# white
color7 {{ theme.palette[7] }}
color15 {{ theme.palette[15] }}
