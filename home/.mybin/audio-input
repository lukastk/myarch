#!/usr/bin/env python3
"""Choose the persistent PipeWire recording source with fzf."""

from __future__ import annotations

import json
import subprocess
import sys


def run(argv: list[str], *, capture: bool = False, check: bool = True, stdin: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, check=check, capture_output=capture, text=True, input=stdin)


def current_name() -> str:
    name = run(["pactl", "get-default-source"], capture=True).stdout.strip()
    if not name:
        raise RuntimeError("PipeWire returned an empty default source")
    return name


def recording_sources() -> list[dict]:
    result = run(["pactl", "--format=json", "list", "sources"], capture=True)
    sources = json.loads(result.stdout)
    recording = [source for source in sources if not source.get("monitor_source")]
    if not recording:
        raise RuntimeError("PipeWire exposes no recording sources")
    return recording


def friendly_name(source: dict) -> str:
    description = source["description"]
    active_port = source.get("active_port")
    if active_port:
        ports = {port["name"]: port["description"] for port in source.get("ports", [])}
        port_description = ports.get(active_port)
        if port_description and port_description != description:
            return f"{port_description} — {description}"

    properties = source.get("properties", {})
    if properties.get("device.bus") == "bluetooth":
        return f"{description} — Bluetooth"
    return description


def choose_source() -> None:
    current = current_name()
    sources = recording_sources()
    by_name = {source["name"]: source for source in sources}
    if current not in by_name:
        raise RuntimeError(f"PipeWire default source is not available: {current}")

    ordered = sorted(sources, key=lambda source: (source["name"] != current, friendly_name(source).casefold()))
    rows = [
        f"{'●' if source['name'] == current else ' '} {friendly_name(source)}\t{source['name']}"
        for source in ordered
    ]
    result = run(
        [
            "fzf",
            "--prompt=input> ",
            "--header=Select the PipeWire recording source",
            "--reverse",
            "--no-multi",
            "--no-sort",
            "--delimiter=\t",
            "--with-nth=1",
        ],
        capture=True,
        check=False,
        stdin="\n".join(rows) + "\n",
    )
    if result.returncode in (1, 130):
        return
    if result.returncode != 0:
        raise RuntimeError(f"fzf exited with status {result.returncode}")

    row = result.stdout.rstrip("\n")
    try:
        selected = row.split("\t", 1)[1]
        source = by_name[selected]
    except (IndexError, KeyError) as exc:
        raise RuntimeError(f"fzf returned an unknown PipeWire source: {row!r}") from exc

    run(["pactl", "set-default-source", selected])
    if current_name() != selected:
        raise RuntimeError(f"PipeWire did not select {selected}")
    run(["notify-send", "Audio input", friendly_name(source)])


if __name__ == "__main__":
    try:
        choose_source()
    except Exception as exc:
        print(f"audio-input: {exc}", file=sys.stderr)
        raise SystemExit(1)
