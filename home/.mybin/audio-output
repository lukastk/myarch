#!/usr/bin/env python3
"""Choose a PipeWire playback output, or return to automatic selection.

WirePlumber owns the preference and its persistence; no parallel state file.
Only playback is changed. The microphone and Bluetooth profile are untouched.
"""
from __future__ import annotations

import json
import subprocess
import sys
import time


def run(argv: list[str], *, capture: bool = False, check: bool = True, stdin: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, check=check, capture_output=capture, text=True, input=stdin)


def defaults() -> tuple[str, str | None]:
    objects = json.loads(run(["pw-dump"], capture=True).stdout)
    metadata = [item for item in objects if item["type"] == "PipeWire:Interface:Metadata"
                and item["props"].get("metadata.name") == "default"]
    if len(metadata) != 1:
        raise RuntimeError("PipeWire must expose exactly one default metadata object")
    values = {entry["key"]: entry["value"] for entry in metadata[0]["metadata"] if entry["subject"] == 0}
    current = values["default.audio.sink"]["name"]
    configured = values.get("default.configured.audio.sink")
    preferred = configured["name"] if configured is not None else None
    if not current or (preferred is not None and not preferred):
        raise RuntimeError("PipeWire returned an empty output name")
    return current, preferred


def sinks_by_name() -> dict[str, dict]:
    sinks = json.loads(run(["pactl", "--format=json", "list", "sinks"], capture=True).stdout)
    if not sinks:
        raise RuntimeError("PipeWire exposes no playback outputs")
    return {sink["name"]: sink for sink in sinks}


def friendly_name(sink: dict) -> str:
    description = sink["description"]
    if sink.get("active_port"):
        for port in sink["ports"]:
            if port["name"] == sink["active_port"] and port["description"] != description:
                return f"{port['description']} — {description}"
    return description


def apply_selection(selected: str | None) -> str:
    if selected is None:
        # 0 is the SETTINGS id for Audio/Sink, NOT a live node id. Omitting it
        # would clear the microphone and camera preferences as well. WirePlumber
        # also clears the sink preference history, restoring priority-based choice.
        run(["wpctl", "clear-default", "0"])
    else:
        # Recheck after the picker: a Bluetooth device can disconnect meanwhile.
        if selected not in sinks_by_name():
            raise RuntimeError(f"Output disconnected while choosing: {selected}")
        run(["pactl", "set-default-sink", selected])

    # Metadata changes are asynchronous. Wait for WirePlumber to acknowledge the
    # preference and, for an explicit choice, elect that actual playback output.
    deadline = time.monotonic() + 2
    while True:
        current, preferred = defaults()
        if preferred == selected and (selected is None or current == selected):
            break
        if time.monotonic() >= deadline:
            raise RuntimeError(f"WirePlumber did not apply output selection: {selected!r}")
        time.sleep(0.05)

    # Move existing playback too, including apps with a remembered per-app target.
    # Changing only the default otherwise leaves those apps on the old speakers.
    streams = json.loads(run(["pactl", "--format=json", "list", "sink-inputs"], capture=True).stdout)
    for stream in streams:
        run(["pactl", "move-sink-input", str(stream["index"]), current])
    return current


def choose_output() -> None:
    current, preferred = defaults()
    sinks = sinks_by_name()
    if current not in sinks:
        raise RuntimeError(f"PipeWire default output is not available: {current}")
    active_name = friendly_name(sinks[current])
    if preferred is None:
        mode = "Automatic"
    elif preferred in sinks:
        mode = f"Preferred: {friendly_name(sinks[preferred])}"
    else:
        mode = f"Preferred output disconnected: {preferred}"

    ordered = sorted(sinks.values(), key=lambda sink: (sink["name"] != current, friendly_name(sink).casefold()))
    rows = [f"{'●' if preferred is None else ' '} Automatic — use device priorities\tauto"]
    choices: dict[str, str | None] = {"auto": None}
    for index, sink in enumerate(ordered):
        token = str(index)
        choices[token] = sink["name"]
        rows.append(f"{'●' if sink['name'] == current else ' '} {friendly_name(sink)}\t{token}")
    result = run(
        ["fzf", "--prompt=output> ", "--header", f"{mode}\nPlaying: {active_name}\nChoose output; Automatic clears override. Input is unchanged.",
         "--reverse", "--no-multi", "--no-sort", "--delimiter=\t", "--with-nth=1"],
        capture=True, check=False, stdin="\n".join(rows) + "\n",
    )
    if result.returncode in (1, 130):
        return
    if result.returncode != 0:
        raise RuntimeError(f"fzf exited with status {result.returncode}")
    row = result.stdout.rstrip("\n")
    if row not in rows:
        raise RuntimeError(f"fzf returned an unknown output: {row!r}")
    selected = choices[row.rsplit("\t", 1)[1]]
    current = apply_selection(selected)
    outputs = sinks_by_name()
    if current not in outputs:
        raise RuntimeError(f"Selected output is no longer available: {current}")
    label = friendly_name(outputs[current])
    if selected is None:
        label = f"Automatic — {label}"
    run(["notify-send", "Audio output", label])


if __name__ == "__main__":
    try:
        choose_output()
    except Exception as exc:
        print(f"audio-output: {exc}", file=sys.stderr)
        subprocess.run(["notify-send", "--urgency=critical", "Audio output failed", str(exc)], check=True)
        raise SystemExit(1)
