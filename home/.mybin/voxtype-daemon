#!/bin/sh
# Start Voxtype with the private environment its post-processing needs.
# The normal Parakeet path needs no API key; the optional cleanup profile reads
# MY_ANTHROPIC_API_KEY when Voxtype invokes voxtype-cleanup.
set -eu

# Ambient, non-secret env (paths etc.) plus any env-tagged secrets.
if [ -f "$HOME/.env" ]; then
    set -a
    . "$HOME/.env"
    set +a
fi

# MY_ANTHROPIC_API_KEY is NOT fetched here, deliberately. This service is
# WantedBy=graphical-session.target, i.e. it starts at LOGIN, which regularly
# beats the network by minutes (pocket4 2026-09-29: session up 11:38:14, wifi
# not associating until 11:43:46). `secret get` shells out to `op`, which needs
# the internet, so a fetch at this point loses that race and leaves the daemon
# keyless for the whole session. ~/.mybin/voxtype-cleanup therefore fetches it
# itself, at the moment a cleanup is actually requested — see its docstring.
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

exec /usr/bin/voxtype -q daemon
