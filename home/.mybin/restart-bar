#!/bin/bash
# restart-bar — bounce waybar. THE one implementation, for every caller.
#
# WHY A RESTART IS THE ONLY REMEDY. Waybar has no IPC to rebuild its surfaces,
# and it dies or half-dies in several ways that all look identical from the
# outside — a bar-shaped hole in the session:
#
#   - Its output is removed and re-added (a display-mode layout change): the
#     process stays alive but its layer surfaces are gone, so you get a running
#     waybar and no bars on any screen, plus a trail of defunct children.
#   - The monitor SCALE changes underneath it (pocket4-tablet-mode): waybar does
#     not reflow, so it keeps the logical width of the OLD scale. On pocket4 the
#     restart also re-picks the layout, since the launcher chooses one-row vs
#     two-row from the width the new scale leaves.
#   - A device it watches disappears: with no explicit "bat" the battery module
#     watches EVERY /sys/class/power_supply entry, so unplugging a DualSense
#     throws an uncaught std::runtime_error out of the inotify watch and
#     terminates the process outright (observed 2026-08-06 20:02:21). The battery
#     module is pinned now, but the general shape of that failure remains.
#
# Callers: display-mode (after every layout change), pocket4-tablet-mode (after
# a scale change), and the Super+CTRL+B keybind for the times something killed
# the bar and you just want it back.
set -euo pipefail

# Every path that restarts the bar shares this lock. Display rotation and tablet
# scale can change almost simultaneously; without serialization, each caller can
# observe no bar during the other's launch window and create a duplicate surface.
# XDG_RUNTIME_DIR is session-local and is required for a graphical-session action.
: "${XDG_RUNTIME_DIR:?restart-bar requires XDG_RUNTIME_DIR from the graphical session}"
LOCK="$XDG_RUNTIME_DIR/myarch-waybar-restart.lock"
exec 9>"$LOCK"
flock 9

LAUNCHER="$HOME/.mybin/pocket4-waybar"
launch=()
case "$#" in
    0)
        if [ -x "$LAUNCHER" ]; then launch=("$LAUNCHER")
        else launch=(waybar)
        fi
        ;;
    3)
        if [ "$1" != "--layout" ]; then
            echo "usage: $0 [--layout <config> <style>]" >&2
            exit 2
        fi
        if [ ! -x "$LAUNCHER" ]; then
            echo "restart-bar: --layout is valid only with the Pocket 4 launcher" >&2
            exit 2
        fi
        launch=("$LAUNCHER" --layout "$2" "$3")
        ;;
    *)
        echo "usage: $0 [--layout <config> <style>]" >&2
        exit 2
        ;;
esac

# `pkill -x` matches the exact process name. Wait for full teardown rather than
# sleeping blindly: the replacement must not race surfaces or child processes
# that still belong to the previous bar.
if pgrep -x waybar >/dev/null; then
    pkill -x waybar
    for _ in $(seq 1 100); do
        pgrep -x waybar >/dev/null || break
        sleep 0.05
    done
    if pgrep -x waybar >/dev/null; then
        echo "restart-bar: waybar did not stop within 5 seconds" >&2
        exit 1
    fi
fi

# Give Hyprland a short teardown grace period, then launch through UWSM so the
# bar remains in the graphical-session scope. Close fd 9 in the child: the parent
# must retain the lock through surface creation, but Waybar must not inherit it.
sleep 0.1
setsid uwsm app -- "${launch[@]}" 9>&- >/dev/null 2>&1 </dev/null &

# Keep the lock until exactly one process has committed a layer surface. This is
# what makes a second, immediately-following state change safe: it cannot observe
# the first launch's no-process window and start another bar.
saw_process=0
for _ in $(seq 1 100); do
    mapfile -t pids < <(pgrep -x waybar)
    if [ "${#pids[@]}" -gt 1 ]; then
        echo "restart-bar: expected one waybar process, found ${#pids[@]}" >&2
        exit 1
    fi
    if [ "${#pids[@]}" -eq 1 ]; then
        saw_process=1
        if hyprctl layers -j 2>/dev/null | jq -e --argjson pid "${pids[0]}" '[.[] | .levels[][] | select(.pid == $pid)] | length > 0' >/dev/null; then
            exit 0
        fi
    elif [ "$saw_process" -eq 1 ]; then
        echo "restart-bar: waybar exited before creating a layer surface" >&2
        exit 1
    fi
    sleep 0.05
done

echo "restart-bar: waybar did not create a layer surface within 5 seconds" >&2
exit 1
