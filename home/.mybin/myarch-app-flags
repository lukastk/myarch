#!/usr/bin/env python3
"""Write each Chromium-based app's launcher flags file for the current desktop mode.

Arch's `brave` and `obsidian` launchers read one flag per line from
$XDG_CONFIG_HOME/<app>-flags.conf at launch. This composes those files from
~/.config/myarch/app-flags.toml: an app's `always` flags, plus the shared
`[tablet] flags` in tablet mode. It is the only writer of those files — myarch's
installer calls it with the current mode, and pocket4-tablet-mode calls it on
every toggle — so the mode logic exists once.

It also records the mode itself in $XDG_STATE_HOME/myarch/desktop-mode, for apps
that switch at runtime rather than at launch (mysystem watches it for Obsidian).

Prints the path of every flags file it wrote, one per line; the installer records
them as installed files. The desktop-mode file is state, not configuration, so it
is not printed.
"""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import sys
import tempfile
import tomllib

# Must match install.py's DISCLAIMER: the installer treats a file carrying it as
# myarch-owned when deciding what to clean up.
DISCLAIMER = "NOTE! This file was generated by myarch; edit its source instead"
MODES = ("laptop", "tablet")


def config_dir() -> Path:
    # The same rule the Arch launchers use to find <app>-flags.conf.
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")


def desktop_mode_file() -> Path:
    # Read by mysystem (desktop-tablet-mode.ts) with the same rule.
    return Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "myarch/desktop-mode"


def string_list(value: object, where: str) -> list[str]:
    if not isinstance(value, list) or not all(isinstance(item, str) and item.startswith("--") for item in value):
        raise SystemExit(f"{where} must be a list of --flag strings, got {value!r}")
    return value


def load(source: Path) -> tuple[list[str], dict[str, dict]]:
    with source.open("rb") as stream:
        data = tomllib.load(stream)
    tablet = data.get("tablet")
    if not isinstance(tablet, dict):
        raise SystemExit(f"{source}: missing [tablet]")
    tablet_flags = string_list(tablet.get("flags"), f"{source}: [tablet] flags")
    if not tablet_flags:
        raise SystemExit(f"{source}: [tablet] flags is empty")
    apps = data.get("apps")
    if not isinstance(apps, dict) or not apps:
        raise SystemExit(f"{source}: no [apps.*] tables")
    for name, app in apps.items():
        where = f"{source}: [apps.{name}]"
        if not isinstance(app, dict) or set(app) != {"file", "always", "tablet"}:
            raise SystemExit(f"{where} must have exactly file, always and tablet")
        file = app["file"]
        if not isinstance(file, str) or not file.endswith("-flags.conf") or "/" in file:
            raise SystemExit(f"{where} file must be a bare <app>-flags.conf name, got {file!r}")
        string_list(app["always"], f"{where} always")
        if not isinstance(app["tablet"], bool):
            raise SystemExit(f"{where} tablet must be true or false")
    return tablet_flags, apps


def atomic_write(destination: Path, content: str) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=destination.parent, prefix=f".{destination.name}.", suffix=".tmp", delete=False) as stream:
        stream.write(content)
        temporary = Path(stream.name)
    try:
        os.chmod(temporary, 0o644)
        # Replaces a regular file or a symlink in place (the old installer linked
        # brave-flags.conf into the repo).
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)


def write(mode: str) -> list[Path]:
    source = config_dir() / "myarch/app-flags.toml"
    tablet_flags, apps = load(source)
    written: list[Path] = []
    for name, app in sorted(apps.items()):
        flags = list(app["always"])
        if mode == "tablet" and app["tablet"]:
            flags += tablet_flags
        header = f"# {DISCLAIMER}\n# Source: {source} (apps.{name}, mode: {mode})\n"
        destination = config_dir() / app["file"]
        atomic_write(destination, header + "".join(flag + "\n" for flag in flags))
        written.append(destination)
    # Last, so an app watching it sees the new mode only once every flags file
    # already matches it.
    atomic_write(desktop_mode_file(), mode + "\n")
    return written


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)
    write_command = commands.add_parser("write", help="write every app's flags file for MODE")
    write_command.add_argument("--mode", required=True, choices=MODES)
    args = parser.parse_args()
    for path in write(args.mode):
        print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
