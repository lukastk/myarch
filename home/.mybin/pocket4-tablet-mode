#!/bin/bash
# pocket4-tablet-mode — toggle touch-oriented behaviour on the GPD Pocket 4.
#
# WHY THIS IS A MANUAL TOGGLE, not automatic:
# The Pocket 4 exposes NO tablet-mode signal. /proc/bus/input/devices shows only
# SW_LID (SW=1); nothing reports SW_TABLET_MODE, and folding the keyboard behind
# the screen does not even change the lid state (verified 2026-07-28 — lid stayed
# "open" throughout a fold). The accelerometer cannot substitute: it lives in the
# screen, so "pad held upright" and "laptop with screen open" produce the same
# gravity vector, and a device lying flat gives no in-plane signal at all.
# So there is nothing to detect. A button it is.
#
# What tablet mode does:
#   - a larger scale, so touch targets are hittable with a finger
#   - tells Chromium-based apps a finger is now the primary pointer, via their
#     launcher flags files (see ~/.config/myarch/app-flags.toml), so pages and
#     Obsidian report `(hover: none)` and show their touch layouts. An app that is
#     already running keeps its flags until it is next launched.
#
# That is ALL it does now. It used to also start lisgd for touchscreen
# gestures; gestures moved to the hyprgrass plugin (installed by
# myarch install.py plugin integration, configured in the GESTURES section of
# src/hyprland/*.lua.jinja). hyprgrass runs inside
# Hyprland, so three-finger swipes are ALWAYS live — in laptop mode too, which
# is what you want — and they drive Hyprland's built-in workspace action, i.e.
# the 1:1 animated swipe that lisgd's after-the-fact recognition could not do.
#
# Deliberately NOT included: disabling the internal keyboard/touchpad, and
# anything to do with the on-screen keyboard. The OSK is fully manual — see the
# note above on().
#
# Usage: pocket4-tablet-mode {on|off|toggle|get}
set -euo pipefail

STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/pocket4"
STATE="$STATE_DIR/tablet-mode"
mkdir -p "$STATE_DIR"

MON="eDP-1"
SCALE_DESKTOP=1.6   # must match POCKET4_SCALE_DESKTOP in src/hyprland/00-monitors.lua.jinja,
SCALE_TABLET=2.0    # and POCKET4_SCALE_TABLET — the config reads $STATE on every reload (tested)

# Poll until the panel reports scale $1 and transform $2, or fail loudly.
wait_for_panel() {
    local s="$1" t="$2" i
    for i in $(seq 20); do
        if hyprctl monitors -j | jq -e --arg mon "$MON" --argjson s "$s" --argjson t "$t" \
            '.[] | select(.name == $mon) | ((.scale - $s) * (.scale - $s) < 0.0001) and (.transform == $t)' >/dev/null; then
            return 0
        fi
        sleep 0.1
    done
    echo "$(basename "$0"): $MON did not reach scale $s transform $t (now: $(hyprctl monitors -j | jq -c --arg mon "$MON" '.[] | select(.name == $mon) | {scale, transform}'))" >&2
    return 1
}

set_scale() {
    local s="$1" t
    t=$(hyprctl monitors -j | jq -r '.[0].transform')
    hyprctl eval "hl.monitor({ output = \"$MON\", mode = \"preferred\", position = \"auto\", scale = $s, transform = $t })" >/dev/null
    # A runtime hl.monitor() only REGISTERS the rule on this Hyprland (0.56, Lua
    # config): it answers "ok" and nothing changes until the rules are re-applied,
    # which hl.dsp.force_renderer_reload() does. It is a DISPATCHER, so it goes
    # through `hyprctl dispatch`, not `eval` (display-mode's trap 2). Without it
    # this script silently did nothing to the panel (found 2026-09-14: tablet
    # mode left the scale at 1.6, rotation left transform 3). Then CHECK the
    # panel really got there, so a future change in that behaviour fails loudly
    # instead of reporting success.
    hyprctl dispatch 'hl.dsp.force_renderer_reload()' >/dev/null
    wait_for_panel "$s" "$t"

    # WAYBAR DOES NOT REFLOW ON A SCALE CHANGE, so the bar is bounced here for
    # the same reason display-mode bounces it after a layout change: changing the
    # scale changes the monitor's LOGICAL width (1600 at 1.6, 1280 at 2.0 in
    # landscape; 1000 and 800 in portrait), and waybar otherwise keeps the width
    # it was laid out for — leaving a bar sized for the screen you just stopped
    # having.
    #
    # The restart must come AFTER the hyprctl above, not before: pocket4-waybar
    # sizes the bar from the scale the monitor is reporting when it starts.
    #
    # 2026-08-15: tablet mode used to keep the ONE-row layout, and at 1280 logical
    # px ~240px of it sat off the edge of the panel. The comment that used to live
    # here recorded that overflow as a deliberately accepted tradeoff — "DO NOT
    # fix this again without asking" — and Lukas has since asked for exactly that
    # fix, so the two-row layout now covers tablet mode in both orientations.
    #
    # ABSOLUTE INSTALLED path, per the note below on sibling scripts.
    "$HOME/.mybin/restart-bar"
}

# The on-screen keyboard is NOT started by tablet mode, and not at session start
# either. It is fully manual — summon and dismiss it with the waybar keyboard
# button, the four-finger-up gesture, or `pocket4-osk toggle` / the `pkb` alias.
# (It used to auto-show on text focus via `wvkbd --auto`; that fought every
# manual toggle and popped up for things as innocuous as opening a terminal, so
# it is gone — see the header of pocket4-osk.)
# Sibling scripts are called by ABSOLUTE INSTALLED path. Two traps here:
#
#  1. ~/.mybin is NOT on the PATH waybar hands to an on-click command (check:
#     systemctl --user show-environment | grep ^PATH), so a bare `pocket4-osk`
#     is "command not found" — and under `set -e` that kills the script BEFORE
#     the state file is written. Symptom: tablet mode applies its scale, but
#     the button never toggles back off, because $STATE still says
#     "off" while the machine is actually in tablet mode.
#
#  2. Do NOT resolve this via `readlink -f "$0"`. ~/.mybin entries are symlinks
#     into the myarch checkout, where the file carries its target marker in the
#     name (^pocket4^pocket4-osk) — so the resolved sibling path does not exist.
#     Use the installed path.
OSK="$HOME/.mybin/pocket4-osk"
APP_FLAGS="$HOME/.mybin/myarch-app-flags"

# The flags reach an app only when it next starts, so say so when one is open —
# otherwise the toggle looks like it did nothing to it.
note_running_apps() {
    local running=()
    pgrep -x brave >/dev/null && running+=(Brave)
    pgrep -x obsidian >/dev/null && running+=(Obsidian)
    [ ${#running[@]} -eq 0 ] && return 0
    notify-send "Tablet mode $1" "Restart ${running[*]} to switch its touch layout."
}

# Leaving tablet mode still STOPS the keyboard, so exiting cannot strand a
# keyboard on screen — but entering it does not start one.
# App flags are written FIRST: if that fails, set -e stops before the scale or
# $STATE change, so the button can never claim a mode the apps were not given.
on()  { "$APP_FLAGS" write --mode tablet >/dev/null; set_scale "$SCALE_TABLET";  echo on  > "$STATE"; note_running_apps on; }
off() { "$APP_FLAGS" write --mode laptop >/dev/null; set_scale "$SCALE_DESKTOP"; "$OSK" hide; echo off > "$STATE"; note_running_apps off; }

case "${1:-toggle}" in
    on)     on ;;
    off)    off ;;
    get)    cat "$STATE" 2>/dev/null || echo off ;;
    status)
        # waybar `return-type: json`. "class" drives the CSS so the button
        # visibly differs when tablet mode is active.
        if [ "$(cat "$STATE" 2>/dev/null || echo off)" = "on" ]; then
            printf '{"text":"\xf3\xb0\x93\xb7","class":"on","tooltip":"Tablet mode ON (large scale, touch layouts in Brave/Obsidian) — tap to exit"}\n'
        else
            printf '{"text":"\xf3\xb0\x93\xb7","class":"off","tooltip":"Tablet mode off — tap for the large touch scale and touch layouts"}\n'
        fi
        ;;
    toggle) if [ "$(cat "$STATE" 2>/dev/null || echo off)" = "on" ]; then off; else on; fi ;;
    *)      echo "usage: $0 {on|off|toggle|get}" >&2; exit 2 ;;
esac
